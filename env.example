# =============================================================================
# LLM provider. Choose "openai" for OpenAI or any OpenAI-compatible API.
# Use "aws_bedrock" only if you want to run the generation pipeline through Bedrock.
# =============================================================================
LLM_PROVIDER=openai

# OpenAI-compatible API
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your_model_name

# AWS Bedrock (optional)
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# =============================================================================
# Snowflake. Obtain access via Spider 2.0 (see DATA.md).
# The AI SQL tasks require a warehouse with Cortex AI functions enabled.
# =============================================================================
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_username
SNOWFLAKE_ROLE=your_role
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_TOKEN=your_snowflake_token_here
